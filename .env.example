# Copia este archivo como ".env.local" y pega tus credenciales de Supabase.
# Las encuentras en: Supabase -> tu proyecto -> Settings -> API
#
# NOTA: la "anon key" es pública por diseño (se usa en el navegador).
# Lo que protege tus datos son las políticas RLS de supabase/setup.sql.
# NUNCA pongas aquí la "service_role key".

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
